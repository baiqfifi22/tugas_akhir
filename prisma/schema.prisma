generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Guru {
  id          Int           @id @default(autoincrement())
  nip         String
  password    String
  nama        String
  email       String
  status      StatusGuru
  noHp        String
  role        Role
  evaluasi    Evaluasi[]
  guruTahun   GuruTahun[]
  laporan     Laporan[]
  sesiAbsensi SesiAbsensi[]
}

model Siswa {
  id         Int             @id @default(autoincrement())
  nis        String
  nama       String
  ttl        String
  status     StatusAktif
  jk         JenisKelamin
  absensi    Absensi[]
  izin       IzinKehadiran[]
  laporan    Laporan[]
  orangTua   OrangTua?
  siswaKelas SiswaKelas[]
}

model Kelas {
  id          Int           @id @default(autoincrement())
  nama        String
  guruTahun   GuruTahun[]
  sesiAbsensi SesiAbsensi[]
  siswaKelas  SiswaKelas[]
}

model TahunAjaran {
  id          Int           @id @default(autoincrement())
  nama        String
  mulai       DateTime
  selesai     DateTime
  isActive    Boolean       @default(false)
  guruTahun   GuruTahun[]
  periode     Periode[]
  sesiAbsensi SesiAbsensi[]
  siswaKelas  SiswaKelas[]
}

model SiswaKelas {
  id            Int          @id @default(autoincrement())
  siswaId       Int
  kelasId       Int
  tahunAjaranId Int?
  kelas         Kelas        @relation(fields: [kelasId], references: [id])
  siswa         Siswa        @relation(fields: [siswaId], references: [id])
  tahun         TahunAjaran? @relation(fields: [tahunAjaranId], references: [id])
}

model GuruTahun {
  id            Int           @id @default(autoincrement())
  guruId        Int
  tahunAjaranId Int
  kelasId       Int
  mataPelajaran MataPelajaran
  guru          Guru          @relation(fields: [guruId], references: [id])
  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  tahun         TahunAjaran   @relation(fields: [tahunAjaranId], references: [id])
}

model SesiAbsensi {
  id            Int           @id @default(autoincrement())
  tahunAjaranId Int
  guruId        Int
  kelasId       Int
  notes         String?
  mataPelajaran MataPelajaran
  tanggal       DateTime
  absensi       Absensi[]
  guru          Guru          @relation(fields: [guruId], references: [id])
  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  tahun         TahunAjaran   @relation(fields: [tahunAjaranId], references: [id])
}

model Absensi {
  id      Int             @id @default(autoincrement())
  siswaId Int
  sesiId  Int
  status  StatusKehadiran
  sesi    SesiAbsensi     @relation(fields: [sesiId], references: [id])
  siswa   Siswa           @relation(fields: [siswaId], references: [id])
}

model Laporan {
  id      Int      @id @default(autoincrement())
  guruId  Int
  siswaId Int
  tanggal DateTime
  uraian  String
  guru    Guru     @relation(fields: [guruId], references: [id])
  siswa   Siswa    @relation(fields: [siswaId], references: [id])
}

model OrangTua {
  id             Int              @id @default(autoincrement())
  siswaId        Int              @unique
  password       String
  nama           String
  email          String
  noHp           String
  siswa          Siswa            @relation(fields: [siswaId], references: [id])
  submitEvaluasi SubmitEvaluasi[]
}

model IzinKehadiran {
  id      Int             @id @default(autoincrement())
  siswaId Int
  mulai   DateTime
  selesai DateTime
  status  StatusKehadiran
  perihal String
  foto    String
  siswa   Siswa           @relation(fields: [siswaId], references: [id])
}

model Periode {
  id             Int              @id @default(autoincrement())
  tahunAjaranId  Int
  mulai          DateTime
  selesai        DateTime
  evaluasi       Evaluasi[]
  tahun          TahunAjaran      @relation(fields: [tahunAjaranId], references: [id])
  submitEvaluasi SubmitEvaluasi[]
}

model Evaluasi {
  id        Int           @id @default(autoincrement())
  periodeId Int
  aspekId   Int
  tipe      String
  guruId    Int?
  skor      Int
  kritik    String?
  tanggal   DateTime

  aspekEval AspekEvaluasi @relation(fields: [aspekId], references: [id])
  guru      Guru?         @relation(fields: [guruId], references: [id])
  periode   Periode       @relation(fields: [periodeId], references: [id])
}

model SubmitEvaluasi {
  id         Int      @id @default(autoincrement())
  orangTuaId Int
  periodeId  Int
  tanggal    DateTime
  orangTua   OrangTua @relation(fields: [orangTuaId], references: [id])
  periode    Periode  @relation(fields: [periodeId], references: [id])

  @@unique([orangTuaId, periodeId])
}

model AspekEvaluasi {
  id       Int        @id @default(autoincrement())
  tipe     String
  teks     String
  aktif    Boolean    @default(true)
  tanggal  DateTime   @default(now())

  evaluasi Evaluasi[]
}

enum StatusGuru {
  AKTIF
  NONAKTIF
}

enum Role {
  KEPALA_SEKOLAH
  WALI_KELAS
  GURU_MAPEL
}

enum StatusKehadiran {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum JenisKelamin {
  L
  P
}

enum StatusAktif {
  AKTIF
  NONAKTIF
}

enum MataPelajaran {
  QURAN_HADIST
  FIQIH
  SKI
  AKIDAH_AKHLAK
  B_ARAB
  BAHASA_INGGRIS
  PJOK
  MATA_PELAJARAN_WAJIB
}
